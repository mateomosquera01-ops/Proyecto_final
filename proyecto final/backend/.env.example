# Server
PORT=4000
NODE_ENV=development

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Auth JWT
JWT_SECRET="replace-with-a-strong-secret-key"
JWT_EXPIRES_IN="8h"

# CORS
CORS_ORIGIN="http://localhost:5173"

# n8n Integration
N8N_WEBHOOK_URL="https://your-n8n-instance.example.com/webhook/textech-lead"
N8N_WEBHOOK_SECRET="optional-webhook-secret"
